rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // L'email est toujours dans le jeton : contrairement a un custom claim, ce
    // droit ne peut pas manquer sur un jeton deja emis, ni se desynchroniser
    // de la fiche joueur. Un compte invite n'en a pas, il n'est donc jamais
    // administrateur.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'lecomte.digitalsolutions@gmail.com';
    }

    function isOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Etat de partie neutre : aucune manche jouee, aucun temps, aucun vote.
    // `get` plutot qu'un acces direct, ces deux champs etant absents des
    // fiches creees avant leur introduction.
    function isClearedGameState(data) {
      return data.currentRoomWins.size() == 0
        && data.finishDate == null
        && data.durationMs == null
        && data.isReady == false
        && data.get('currentRoundProgress', null) == null
        && data.get('vote', null) == null;
    }

    match /players/{playerId} {
      // Classement, recherche d'amis et page admin lisent toute la collection.
      allow read: if isSignedIn();

      // Un compte ne cree que sa propre fiche : ni administrateur, ni
      // medailles, ni amis, ni partie deja jouee. Sans ces bornes, une fiche
      // fabriquee a la main pouvait naitre en tete du classement, les
      // medailles n'etant protegees qu'en modification. Les compteurs partent
      // vides, `submitRound` creant celui d'un jeu a sa premiere medaille.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isAdmin == false
        && request.resource.data.stats.size() == 0
        && request.resource.data.get('friendIds', []).size() == 0
        && request.resource.data.get('friendRequestIds', []).size() == 0
        && isClearedGameState(request.resource.data);

      allow update: if isAdmin()
        // Le proprietaire modifie sa fiche, sauf les champs reserves aux
        // fonctions : medailles, role et listes d'amis.
        || (isOwner(resource.data)
            && !changedKeys().hasAny([
                 'userId',
                 'isAdmin',
                 'stats',
                 'friendIds',
                 'friendRequestIds'
               ]))
        // Un tiers ne fait que remettre l'etat de partie a zero : relance
        // par l'hote, exclusion d'un joueur. Les valeurs sont imposees, donc
        // personne ne peut fabriquer un resultat, un temps ou un vote a la
        // place d'un autre. Seul le proprietaire ecrit sa progression.
        || (changedKeys().hasOnly([
              'currentRoomWins',
              'finishDate',
              'durationMs',
              'isReady',
              'currentRoundProgress',
              'vote'
            ])
            && isClearedGameState(request.resource.data));

      allow delete: if isAdmin() || isOwner(resource.data);
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // L'hote pilote sa room ; les autres n'y ajoutent et n'en retirent que
      // leur propre identifiant, pour entrer et sortir.
      allow update: if isAdmin()
        || isOwner(resource.data)
        || (changedKeys().hasOnly(['playerIds'])
            && request.resource.data.playerIds.toSet()
                 .difference(resource.data.playerIds.toSet())
                 .hasOnly([request.auth.uid])
            && resource.data.playerIds.toSet()
                 .difference(request.resource.data.playerIds.toSet())
                 .hasOnly([request.auth.uid]));

      allow delete: if isAdmin() || isOwner(resource.data);
    }

    match /invitations/{invitationId} {
      // Une invitation ne regarde que ses deux extremites. Le menage apres
      // suppression d'une room est fait par la fonction `onRoomDeleted`, avec
      // le SDK Admin : le client n'a pas besoin d'un acces plus large.
      allow read, delete: if isSignedIn()
        && (resource.data.toUserId == request.auth.uid
            || resource.data.fromUserId == request.auth.uid);

      allow create, update: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid;
    }

    // Journal des erreurs : ecrit sans jamais etre relu par le client, pour
    // que les incidents remontent au lieu de s'afficher au joueur.
    match /errors/{errorId} {
      function boundedText(field, max) {
        return !(request.resource.data.get(field, null) is string)
          || request.resource.data[field].size() <= max;
      }

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && boundedText('stack', 4000)
        && boundedText('url', 2000)
        && boundedText('userAgent', 1000);

      allow read, update, delete: if isAdmin();
    }

    // Un document par jeton Web Push, l'identifiant du document etant le
    // jeton lui-meme. La fonction `notifyInvitation` les lit avec le SDK
    // Admin, donc hors regles.
    match /fcmTokens/{token} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
