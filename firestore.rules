rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /players/{playerId} {
      // Classement, recherche d'amis et page admin lisent toute la collection.
      allow read: if isSignedIn();

      // Un compte ne cree que sa propre fiche, sans s'y declarer
      // administrateur ni se pre-attribuer des medailles.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isAdmin == false;

      allow update: if isAdmin()
        // Le proprietaire modifie sa fiche, sauf `stats` (reserve aux
        // fonctions), `isAdmin` et `userId`.
        || (isOwner(resource.data)
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.isAdmin == resource.data.isAdmin
            && request.resource.data.stats == resource.data.stats)
        // Un tiers ne touche que l'etat de partie (remise a zero par l'hote,
        // exclusion d'un joueur) et les listes d'amis.
        || changedKeys().hasOnly([
             'currentRoomWins',
             'finishDate',
             'durationMs',
             'isReady',
             'friendIds',
             'friendRequestIds'
           ]);

      allow delete: if isAdmin() || isOwner(resource.data);
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // L'hote pilote sa room ; les autres n'en modifient que la liste des
      // participants, pour entrer et sortir.
      allow update: if isAdmin()
        || isOwner(resource.data)
        || changedKeys().hasOnly(['playerIds']);

      allow delete: if isAdmin() || isOwner(resource.data);
    }

    match /invitations/{invitationId} {
      // Lecture large : le destinataire filtre sur `toUserId`, et celui qui
      // supprime une room interroge par `roomId` pour faire le menage.
      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid;

      // Volontairement large pour la meme raison : supprimer une room efface
      // aussi les invitations envoyees par les autres participants.
      allow delete: if isSignedIn();
    }

    // Un document par jeton Web Push, l'identifiant du document etant le
    // jeton lui-meme. La fonction `notifyInvitation` les lit avec le SDK
    // Admin, donc hors regles.
    match /fcmTokens/{token} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /excluded-questions/{excludedQuestionsId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.userId;
    }
  }
}
